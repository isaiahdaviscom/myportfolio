{
    "xd.globalEditor": false,
    "xd.lastPackage": "/c:/Users/IBlac/Desktop/Netlify/myportfolio/design-system",
    "githubPullRequests.ignoredPullRequestBranches": [
        "master"
    ],
    "workbench.colorTheme": "Abyss",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.editor.labelFormat": "short",
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.tabCloseButton": "off",
    "workbench.editor.tabActionCloseVisibility": false,
    
    // Chrome DevTools Workspace Configuration
    "chrome.executable": "chrome",
    "chrome.webRoot": "${workspaceFolder}/public",
    "chrome.sourceMapPathOverrides": {
        "webpack:///./~/*": "${webRoot}/node_modules/*",
        "webpack:///./*": "${webRoot}/*",
        "webpack:///src/*": "${webRoot}/*",
        "webpack:///./src/*": "${webRoot}/*"
    },
    
    // CSS and styling configuration
    "css.validate": false,
    "scss.validate": false,
    "less.validate": false,
    "stylelint.validate": ["css", "scss", "postcss"],
    
    // HTML and Hugo configuration
    "emmet.includeLanguages": {
        "hugo": "html",
        "html": "html"
    },
    "files.associations": {
        "**/layouts/**/*.html": "hugo",
        "**/themes/**/layouts/**/*.html": "hugo",
        "**/partials/**/*.html": "hugo",
        "**/shortcodes/**/*.html": "hugo",
        "*.html": "hugo",
        "*.md": "markdown"
    },
    "html.format.enable": false,
    "html.validate.scripts": false,
    "html.format.wrapLineLength": 0,
    "html.format.unformatted": "wbr",
    "html.format.contentUnformatted": "pre,code,textarea",
    "html.format.extraLiners": "head, body, /html",
    "html.format.preserveNewLines": true,
    "html.format.maxPreserveNewLines": 2,
    
    // Suppress Hugo template false positives
    "html.validate.styles": false,
    "css.lint.compatibleVendorPrefixes": "ignore",
    "css.lint.vendorPrefix": "ignore",
    "css.lint.unknownProperties": "ignore",
    
    // HTML structure validation suppressions for Hugo templates
    "html.customData": [".vscode/hugo-html.json"],
    "html.completion.attributeDefaultValue": "doublequotes",
    
    // Hugo-specific validation suppression
    "[hugo]": {
        "html.validate.scripts": false,
        "html.validate.styles": false,
        "html.suggest.html5": false,
        "html.hover.documentation": false,
        "html.format.enable": false,
        "html.validate": false
    },
    
    // Global HTML validation suppressions for specific Hugo issues
    "html.trace.server": "off",
    "html.experimental.custom.data": [],
    
    // Path-based validation for Hugo layouts
    "files.exclude": {
        "**/public/**": true
    },
    "search.exclude": {
        "**/public/**": true,
        "**/node_modules/**": true,
        "**/.git/**": true
    },
    "files.watcherExclude": {
        "**/public/**": true,
        "**/node_modules/**": true
    },
    
    // Microsoft Edge Tools and browser compatibility suppression
    "edge-tools.webhint.enable": false,
    "microsoft-edge-tools.webhint": false,
    
    // Problem matcher suppressions for Hugo-specific false positives
    "problems.decorations.enabled": true,
    "problems.showCurrentInStatus": false,
    "html.format.indentInnerHtml": false,
    "html.format.wrapAttributes": "auto",
    "html.format.templating": true,
    "html.hover.documentation": true,
    "html.suggest.html5": true,
    "html.autoClosingTags": true,
    
    // TailwindCSS configuration
    "tailwindCSS.includeLanguages": {
        "hugo": "html",
        "html": "html"
    },
    "tailwindCSS.files.exclude": [
        "**/.git/**",
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "**/public/**"
    ],
    
    // Live Server and debugging
    "liveServer.settings.port": 5500,
    "liveServer.settings.root": "/public",
    "liveServer.settings.CustomBrowser": "chrome",
    "liveServer.settings.ChromeDebuggingAttachment": true
}