# Netlify Environment Variables Template
# Add these in your Netlify dashboard under Site Settings > Environment Variables

# Hugo Configuration
HUGO_ENV=production
HUGO_VERSION=0.132.2

# Node.js Configuration  
NODE_ENV=production
NODE_VERSION=18
NPM_VERSION=9

# Build Configuration
HUGO_ENABLEGITINFO=true

# Optional: Hugo Module Configuration (if using modules)
# GO_VERSION=1.19

# Custom Environment Variables (uncomment and set as needed)
# SITE_URL=https://isaiahdavis.com
# API_URL=your-api-url
# ANALYTICS_ID=your-analytics-id