{
  "name": "myportfolio",
  "version": "1.0.0",
  "description": "- [Hugo Project Setup in Existing Directory](#hugo-project-setup-in-existing-directory)\r   - [Prerequisites](#prerequisites)\r   - [Initialize Hugo](#initialize-hugo)\r   - [Configuration Steps](#configuration-steps)\r     - [1. Change Directory](#1-change-directory)\r     - [2. Theme Setup](#2-theme-setup)\r     - [3. Configure Your Theme](#3-configure-your-theme)\r     - [4. Create Content](#4-create-content)\r     - [5. Start the Server](#5-start-the-server)\r   - [Build Your Site](#build-your-site)\r   - [Deployment](#deployment)\r   - [Version Control](#version-control)\r   - [Conclusion](#conclusion)",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build-pipeline.js",
    "build:dev": "node scripts/build-pipeline.js --dev",
    "build:prod": "node scripts/build-pipeline.js --prod",
    "build:all": "npm run build:css && npm run build:js && npm run build:hugo",
    "build:css": "npx postcss src/css/tailwind.css -o static/css/styles.css",
    "build:js": "npx esbuild themes/myPortfolio/assets/js/main.js --minify --bundle --outfile=static/js/main.js",
    "build:hugo": "hugo --gc --minify",
    "build:hugo:dev": "hugo --config hugo.toml,config.development.toml --gc --minify",
    "build:hugo:prod": "hugo --config hugo.toml,config.production.toml --gc --minify",
    "watch": "npx postcss src/css/tailwind.css -o static/css/styles.css --watch",
    "hugo": "hugo server -D",
    "start": "npm run watch & npm run hugo",
    "deploy": "npm run build:all",
    "predeploy": "npm run build:all",
    "postbuild": "echo 'Build complete!'",
    "clean": "node scripts/clean-command.js light",
    "clean:light": "node scripts/clean-command.js light",
    "clean:deep": "node scripts/clean-command.js deep",
    "clean:nuclear": "node scripts/clean-command.js nuclear",
    "clean:cache": "node scripts/clean-command.js cache",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:md",
    "lint:css": "stylelint \"src/**/*.css\" \"themes/**/*.css\"",
    "lint:js": "eslint \"themes/**/assets/js/**/*.js\" \"static/js/**/*.js\"",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore .git",
    "format": "prettier --write \"**/*.{js,css,html,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json,yml,yaml}\"",
    "test": "npm run lint && npm run format:check && npm run build:all",
    "test:security": "npm audit --audit-level moderate",
    "test:performance": "npm run build:all && node scripts/performance-test.js",
    "serve": "npx http-server public -p 8080",
    "css:analyze": "node scripts/css-analyzer.js",
    "css:optimize": "npm run build:css && node scripts/css-analyzer.js",
    "css:report": "node scripts/css-analyzer.js",
    "css:unused": "node scripts/unused-css-detector.js",
    "css:audit": "npm run css:analyze && npm run css:unused",
    "css:cleanup": "node scripts/css-cleanup.js",
    "css:cleanup:actual": "node scripts/css-cleanup.js --actual",
    "build:css:prod": "npm run css:optimize"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@tailwindcss/postcss": "^4.1.4",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.0.7",
    "esbuild": "^0.25.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "http-server": "^14.1.1",
    "markdownlint-cli": "^0.37.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.0.3",
    "purgecss": "^7.0.2",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "tailwindcss": "^4.1.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
