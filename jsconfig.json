{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES6"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "sourceMap": true,
    "declaration": false,
    "outDir": "public/js",
    "baseUrl": "./",
    "paths": {
      "@/*": ["themes/myPortfolio/assets/*"],
      "@css/*": ["src/css/*"],
      "@js/*": ["themes/myPortfolio/assets/js/*"],
      "@static/*": ["static/*"]
    }
  },
  "include": ["themes/myPortfolio/assets/**/*", "src/**/*", "static/js/**/*"],
  "exclude": ["node_modules", "public", ".chrome-debug-profile"]
}
